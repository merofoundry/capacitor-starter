{
  "name": "merofoundry-capacitor-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell that loads a MeroFoundry application's hosted site, with native lock, offline, settings, share, haptics and deep links.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.cjs\"",
    "assets": "node scripts/prepare-assets.cjs",
    "ios:prepare": "node scripts/prepare-ios.cjs",
    "release:guard": "node scripts/release-guard.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "meroshell-bootstrap": "file:native/shell-bootstrap"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "html-validate": "11.16.3",
    "parse5": "8.0.1",
    "sharp": "0.32.6",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
